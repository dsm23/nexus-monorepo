{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Praveen Sripati",
  "description": "A comprehensive, modern intranet dashboard built with React, TypeScript, and Tailwind CSS",
  "scripts": {
    "dev": "vite --clearScreen false",
    "build": "tsc -b && vite build",
    "fmt": "prettier . --write",
    "fmt.check": "prettier . --check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0 --allow-empty-input",
    "lint": "run-p lint:js lint:css",
    "preview": "vite preview"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "@tailwindcss/vite": "4.1.18",
    "lucide-react": "0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-organizational-chart": "2.2.1",
    "react-router-dom": "7.12.0",
    "recharts": "3.6.0",
    "sonner": "2.0.7",
    "tailwindcss": "4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@repo/stylelint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.1",
    "globals": "17.0.0",
    "npm-run-all2": "8.0.4",
    "prettier": "3.7.4",
    "prettier-plugin-css-order": "2.2.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "typed-query-selector": "2.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "6.0.3"
  }
}
